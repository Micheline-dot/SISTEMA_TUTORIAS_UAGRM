# .env de PRODUCCIÓN — copiar a /var/www/tutorias-uagrm/.env y completar.
# Los valores vacíos (contraseñas, APP_KEY) se escriben directamente en el
# servidor; nunca se suben al repositorio.

APP_NAME="Tutorías UAGRM"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://tutorias.example.com
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sistema_tutorias_uagrm
DB_USERNAME=tutorias_app
DB_PASSWORD=

# Administrador inicial (solo para el primer `php artisan db:seed`).
# Después de crearlo, BORRAR ADMIN_PASSWORD de este archivo.
ADMIN_NOMBRES=
ADMIN_APELLIDOS=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TELEFONO=
ADMIN_CARGO="Administrador del sistema"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
